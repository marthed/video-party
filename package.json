{
  "name": "video-party",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that syncs play/pause/seek of HTML5 video between browsers, peer-to-peer.",
  "scripts": {
    "build": "esbuild src/offscreen.js --bundle --format=iife --target=chrome110 --outfile=extension/offscreen.bundle.js",
    "watch": "npm run build -- --watch",
    "package": "node scripts/package.mjs",
    "icons": "python3 scripts/make_icons.py"
  },
  "dependencies": {
    "trystero": "^0.26.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
