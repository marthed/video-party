{
  "manifest_version": 3,
  "name": "Video Party",
  "version": "1.0.1",
  "description": "Watch videos together with friends: play, pause and seeking stay in sync between browsers, peer-to-peer.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["offscreen", "storage", "scripting"],
  "host_permissions": [
    "https://*.svtplay.se/*",
    "https://*.youtube.com/*",
    "https://*.netflix.com/*",
    "https://*.disneyplus.com/*",
    "https://*.primevideo.com/*",
    "https://*.hbomax.com/*",
    "https://*.max.com/*",
    "https://open.spotify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Video Party",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.svtplay.se/*",
        "https://*.youtube.com/*",
        "https://*.netflix.com/*",
        "https://*.disneyplus.com/*",
        "https://*.primevideo.com/*",
        "https://*.hbomax.com/*",
        "https://*.max.com/*",
        "https://open.spotify.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.netflix.com/*"],
      "js": ["netflix-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
